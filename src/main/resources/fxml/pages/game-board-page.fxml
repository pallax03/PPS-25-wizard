<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <BorderPane fx:id="rootPane"
                prefWidth="1200.0"
                prefHeight="800.0"
                style="-fx-background-color: #1a1a1a;">

        <padding>
            <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
        </padding>

        <top>
            <HBox alignment="CENTER" maxWidth="Infinity">
                <BorderPane.margin>
                    <Insets bottom="15.0"/>
                </BorderPane.margin>
                <VBox fx:id="gameInfoContainer" alignment="CENTER_LEFT" spacing="10.0" prefHeight="80.0">
                    <padding>
                        <Insets top="0" right="0" bottom="0" left="0"/>
                    </padding>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox fx:id="playersContainer" alignment="CENTER_RIGHT" spacing="30.0" prefHeight="80.0"/>
            </HBox>
        </top>

        <left>
            <VBox alignment="CENTER" spacing="30.0">
                <BorderPane.margin>
                    <Insets right="20.0"/>
                </BorderPane.margin>
                <VBox fx:id="trumpContainer" alignment="CENTER" spacing="10.0"/>
                <VBox fx:id="currentPlayerContainer" alignment="CENTER" spacing="10.0"/>
            </VBox>
        </left>

        <center>
            <HBox fx:id="tableContainer"
                  alignment="CENTER"
                  style="-fx-background-color: rgba(43, 92, 63, 0.85); -fx-background-radius: 15;">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>
            </HBox>
        </center>

        <bottom>
            <HBox fx:id="handContainer"
                  alignment="CENTER"
                  prefHeight="180.0"
                  style="-fx-background-color: #A0A2A180; -fx-background-radius: 15;">
                <BorderPane.margin>
                    <Insets top="15.0"/>
                </BorderPane.margin>
            </HBox>
        </bottom>

        <right>
            <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
                <BorderPane.margin>
                    <Insets left="15.0"/>
                </BorderPane.margin>

                <StackPane fx:id="scoreboardContainer"
                           prefWidth="45.0"
                           maxHeight="280.0"
                           onMouseClicked="#openScoreboardWindow"
                           onMouseEntered="#handleScoreboardHover"
                           onMouseExited="#handleScoreboardExit"
                           style="-fx-background-color: linear-gradient(to left, #16301f, #254d34);
                                  -fx-background-radius: 15 0 0 15;
                                  -fx-border-color: rgba(212, 175, 55, 0.5);
                                  -fx-border-width: 1 0 1 1;
                                  -fx-border-radius: 15 0 0 15;
                                  -fx-cursor: hand;
                                  -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.4), 8, 0, -2, 0);">
                    <padding>
                        <Insets top="15.0" bottom="15.0" left="5.0" right="5.0"/>
                    </padding>
                    <VBox alignment="CENTER" spacing="4.0">
                        <SVGPath content="M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.66 4.43 4.91C8.21 14.14 10 16 12 16v3H9v2h6v-2h-3v-3c2 0 3.79-1.86 4.57-4.09C19.08 11.66 21 9.55 21 7V5c0-1.1-.9-2-2-2zm-14 3V7h2v3c0-1.1-.9-2-2-2zm14 0c-1.1 0-2 .9-2 2V7h2v1z"
                                 fill="#d4af37" scaleX="0.9" scaleY="0.9"/>
                        <Region prefHeight="8.0"/>
                        <Label text="S" style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <Label text="C" style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <Label text="O" style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <Label text="R" style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <Label text="E" style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <Label text="B" style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <Label text="O" style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <Label text="A" style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <Label text="R" style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <Label text="D" style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                    </VBox>
                </StackPane>

                <Button text="RULES"
                        onAction="#toggleRulesPanel"
                        style="-fx-background-color: #254d34;
                               -fx-text-fill: #e67e22;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;
                               -fx-border-color: #e67e22;
                               -fx-border-radius: 10;
                               -fx-cursor: hand;"/>
            </VBox>
        </right>
    </BorderPane>

    <VBox fx:id="rulesPanel"
          visible="false"
          managed="false"
          alignment="CENTER"
          maxWidth="650.0"
          maxHeight="550.0"
          style="-fx-background-color: rgba(30, 30, 30, 0.98);
                 -fx-border-color: #e67e22;
                 -fx-border-width: 2;
                 -fx-background-radius: 15;
                 -fx-border-radius: 15;
                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 15, 0, 0, 0);">
        <padding>
            <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
        </padding>

        <Label text="WIZARD GAME RULES"
               style="-fx-text-fill: #e67e22; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Region prefHeight="15.0"/>

        <ScrollPane fitToWidth="true"
                prefHeight="400.0"
                hbarPolicy="NEVER"
                style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="10.0">
                <padding>
                    <Insets right="10.0"/>
                </padding>
                <!-- 1. OBJECT OF THE GAME & BIDDING -->
                <Label text="1. Object of the Game &amp; Bidding:"
                       wrapText="true" style="-fx-text-fill: #f0eae1; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="Predict exactly how many tricks you will win in each round to earn points. In Round 1 you have 1 card, in Round 2 you have 2 cards, and so on. Your maximum bid equals the current round number."
                       wrapText="true" style="-fx-text-fill: #f0eae1; -fx-font-size: 13px;"/>

                <!-- 2. CARD HIERARCHY -->
                <Label text="2. Card Hierarchy:"
                       wrapText="true" style="-fx-text-fill: #f0eae1; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="Wizards (Z) always win the trick. Jesters (N) always lose. Trump suit cards beat any standard suit card. If no Trump or Wizard is played, the highest card of the led suit wins."
                       wrapText="true" style="-fx-text-fill: #f0eae1; -fx-font-size: 13px;"/>

                <!-- 3. TRUMP SELECTION CASES -->
                <Label text="3. Special Trump Cases:"
                       wrapText="true" style="-fx-text-fill: #f0eae1; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="If a Wizard is flipped for Trump, the dealer chooses the Trump suit before bidding. If a Jester is flipped, or in the final round of the game, there is NO Trump suit for that round."
                       wrapText="true" style="-fx-text-fill: #f0eae1; -fx-font-size: 13px;"/>

                <!-- 4. PLAYING RULES -->
                <Label text="4. What Card Can You Play?:"
                       wrapText="true" style="-fx-text-fill: #f0eae1; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="You must follow the led suit if possible. However, you can ALWAYS play a Wizard or a Jester at any time, even if you have the led suit. If you do not have the led suit, you may play any card (Trump or slough)."
                       wrapText="true" style="-fx-text-fill: #f0eae1; -fx-font-size: 13px;"/>

                <!-- 5. EDGE CASES: MULTIPLE WIZARDS/JESTERS -->
                <Label text="5. Multiple Wizards or Jesters:"
                       wrapText="true" style="-fx-text-fill: #f0eae1; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="If multiple Wizards are played, the FIRST Wizard played wins the trick. Jesters always lose; however, if a trick consists ONLY of Jesters, the FIRST Jester played wins the trick."
                       wrapText="true" style="-fx-text-fill: #f0eae1; -fx-font-size: 13px;"/>

                <!-- 6. EDGE CASES: SPECIAL LEADS -->
                <Label text="6. Special Card Led First:"
                       wrapText="true" style="-fx-text-fill: #f0eae1; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="If a Wizard is led first, there are no suit restrictions for that trick (players can throw anything). If a Jester is led first, it has no suit, so the SECOND player's card establishes the led suit."
                       wrapText="true" style="-fx-text-fill: #f0eae1; -fx-font-size: 13px;"/>

                <!-- 7. SCORING -->
                <Label text="7. Scoring System:"
                       wrapText="true" style="-fx-text-fill: #f0eae1; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="Correct bids award 20 points plus 10 points per trick won (e.g., bid 2, win 2 = +40 pts). Incorrect bids deduct 10 points for each trick you are over or under your bid (e.g., bid 1, win 0 = -10 pts)."
                       wrapText="true" style="-fx-text-fill: #f0eae1; -fx-font-size: 13px;"/>
            </VBox>
        </ScrollPane>

        <Region prefHeight="20.0"/>
        <Button text="Close"
                onAction="#toggleRulesPanel"
                style="-fx-background-color: #e67e22; -fx-text-fill: #1a1a1a; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"/>
    </VBox>

</StackPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Region?>
<BorderPane fx:id="rootPane"
            prefWidth="1200.0"
            prefHeight="800.0"
            style="-fx-background-color: #1a1a1a;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <top>
        <HBox alignment="CENTER" maxWidth="Infinity">
            <BorderPane.margin>
                <Insets bottom="15.0"/>
            </BorderPane.margin>
            <VBox fx:id="gameInfoContainer"
                  alignment="CENTER_LEFT"
                  spacing="10.0"
                  prefHeight="80.0">
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox fx:id="playersContainer"
                  alignment="CENTER_RIGHT"
                  spacing="30.0"
                  prefHeight="80.0">
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox alignment="CENTER" spacing="30.0">
            <BorderPane.margin>
                <Insets right="20.0"/>
            </BorderPane.margin>
            <VBox fx:id="trumpContainer" alignment="CENTER" spacing="10.0"/>

            <VBox fx:id="currentPlayerContainer" alignment="CENTER" spacing="10.0"/>
        </VBox>
    </left>

    <center>
        <HBox fx:id="tableContainer"
              alignment="CENTER"
              style="-fx-background-color: rgba(43, 92, 63, 0.85); -fx-background-radius: 15;">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
        </HBox>
    </center>

    <bottom>
        <HBox fx:id="handContainer"
              alignment="CENTER"
              prefHeight="180.0"
              style="-fx-background-color: #A0A2A180; -fx-background-radius: 15;">
            <BorderPane.margin>
                <Insets top="15.0"/>
            </BorderPane.margin>
        </HBox>
    </bottom>
    <right>
        <StackPane fx:id="scoreboardContainer"
                   prefWidth="45.0"
                   maxHeight="280.0"
                   BorderPane.alignment="CENTER"
                   onMouseClicked="#openScoreboardWindow"
                   onMouseEntered="#handleScoreboardHover"
                   onMouseExited="#handleScoreboardExit"
                   style="-fx-background-color: linear-gradient(to left, #16301f, #254d34);
                          -fx-background-radius: 15 0 0 15;
                          -fx-border-color: rgba(212, 175, 55, 0.5);
                          -fx-border-width: 1 0 1 1;
                          -fx-border-radius: 15 0 0 15;
                          -fx-cursor: hand;
                          -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.4), 8, 0, -2, 0);">

            <BorderPane.margin>
                <Insets left="15.0"/>
            </BorderPane.margin>

            <padding>
                <Insets top="15.0" bottom="15.0" left="5.0" right="5.0"/>
            </padding>

            <VBox alignment="CENTER" spacing="4.0">
                <SVGPath
                        content="M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.66 4.43 4.91C8.21 14.14 10 16 12 16v3H9v2h6v-2h-3v-3c2 0 3.79-1.86 4.57-4.09C19.08 11.66 21 9.55 21 7V5c0-1.1-.9-2-2-2zm-14 3V7h2v3c0-1.1-.9-2-2-2zm14 0c-1.1 0-2 .9-2 2V7h2v1z"
                        fill="#d4af37"
                        scaleX="0.9"
                        scaleY="0.9"/>

                <Region prefHeight="8.0"/>

                <Label text="S"
                       style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px; -fx-font-family: 'Segoe UI', Helvetica;"/>
                <Label text="C"
                       style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px; -fx-font-family: 'Segoe UI', Helvetica;"/>
                <Label text="O"
                       style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px; -fx-font-family: 'Segoe UI', Helvetica;"/>
                <Label text="R"
                       style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px; -fx-font-family: 'Segoe UI', Helvetica;"/>
                <Label text="E"
                       style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px; -fx-font-family: 'Segoe UI', Helvetica;"/>
                <Label text="B"
                       style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px; -fx-font-family: 'Segoe UI', Helvetica;"/>
                <Label text="O"
                       style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px; -fx-font-family: 'Segoe UI', Helvetica;"/>
                <Label text="A"
                       style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px; -fx-font-family: 'Segoe UI', Helvetica;"/>
                <Label text="R"
                       style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px; -fx-font-family: 'Segoe UI', Helvetica;"/>
                <Label text="D"
                       style="-fx-text-fill: #f0eae1; -fx-font-weight: bold; -fx-font-size: 11px; -fx-font-family: 'Segoe UI', Helvetica;"/>
            </VBox>
        </StackPane>
    </right>

</BorderPane>